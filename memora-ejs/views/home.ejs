<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Memora · Your notes</title>
  <style>
    :root {
      --ink: #1e1b2e;
      --muted: #716d80;
      --violet: #6d4aff;
      --line: #e9e6ef;
      --paper: #fffdf7;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: #f8f7fc;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .shell {
      width: min(1120px, calc(100% - 40px));
      margin: auto;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 76px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 850;
      letter-spacing: -.05em;
    }

    .logo {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      color: #fff;
      border-radius: 10px;
      background: var(--violet);
    }

    .nav {
      display: flex;
      gap: 18px;
      align-items: center;
      font-size: 14px;
    }

    .nav a {
      color: var(--muted);
      font-weight: 700;
      text-decoration: none;
    }

    .nav a:last-child {
      padding: 9px 14px;
      border-radius: 9px;
      color: #fff;
      background: var(--violet);
    }

    main {
      padding: 52px 0 70px;
    }

    .eyebrow {
      margin: 0 0 11px;
      color: var(--violet);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 650px;
      margin: 0;
      font-size: clamp(36px, 6vw, 58px);
      line-height: 1.02;
      letter-spacing: -.07em;
    }

    .lead {
      max-width: 540px;
      margin: 18px 0 34px;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.6;
    }

    .notice {
      margin: 0 0 22px;
      padding: 13px 15px;
      border: 1px solid #d9d0ff;
      border-radius: 12px;
      color: #452aa8;
      background: #f0edff;
      font-weight: 650;
    }

    .composer {
      display: grid;
      grid-template-columns: 1fr 1.5fr auto;
      gap: 12px;
      align-items: end;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: #fff;
      box-shadow: 0 12px 35px rgba(31, 20, 75, .06);
    }

    .field {
      display: grid;
      gap: 7px;
    }

    label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
    }

    input {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      outline: none;
      color: var(--ink);
      font: inherit;
    }

    input:focus {
      border-color: var(--violet);
      box-shadow: 0 0 0 3px #eeeaff;
    }

    button {
      min-height: 43px;
      padding: 0 18px;
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      color: #fff;
      background: var(--violet);
      font: 750 14px inherit;
    }

    button:hover {
      background: #5637db;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin: 52px 0 18px;
    }

    .section-head h2 {
      margin: 0;
      font-size: 21px;
      letter-spacing: -.04em;
    }

    .count {
      color: var(--muted);
      font-size: 14px;
    }

    .notes {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
    }

    .note {
      min-height: 170px;
      padding: 21px;
      border: 1px solid #f0e5b7;
      border-radius: 4px 18px 18px 18px;
      background: var(--paper);
      box-shadow: 0 8px 20px rgba(99, 82, 11, .06);
    }

    .note:nth-child(3n+2) {
      background: #f6f0ff;
      border-color: #e4d9ff;
    }

    .note:nth-child(3n) {
      background: #ecfbf6;
      border-color: #cdeee3;
    }

    .note h3 {
      margin: 0 0 11px;
      font-size: 18px;
      line-height: 1.25;
      letter-spacing: -.035em;
    }

    .note p {
      margin: 0;
      color: #5b5768;
      line-height: 1.55;
      white-space: pre-wrap;
    }

    .note-actions {
      display: flex;
      gap: 8px;
      margin-top: 22px;
    }

    .note-actions form {
      margin: 0;
    }

    .note-actions button {
      min-height: 34px;
      padding: 0 12px;
      background: transparent;
      color: #5b5768;
      border: 1px solid #dcd7e5;
    }

    .note-actions button:hover {
      background: #fff;
      color: var(--violet);
      border-color: var(--violet);
    }

    .note-actions .delete-button:hover {
      color: #b42318;
      border-color: #f0b7b2;
      background: #fff6f5;
    }

    .empty {
      padding: 46px 24px;
      border: 1px dashed #d8d4e2;
      border-radius: 16px;
      color: var(--muted);
      text-align: center;
      background: #fff;
    }

    .empty strong {
      display: block;
      margin-bottom: 7px;
      color: var(--ink);
      font-size: 17px;
    }

    @media (max-width:680px) {
      .shell {
        width: min(100% - 28px, 1120px);
      }

      .topbar {
        min-height: 66px;
      }

      .nav a:first-child {
        display: none;
      }

      main {
        padding-top: 32px;
      }

      .composer {
        grid-template-columns: 1fr;
      }

      .section-head {
        margin-top: 38px;
      }
    }
  </style>
</head>

<body>
  <header class="shell topbar">
    <a class="brand" href="/" aria-label="Memora home">
      <span class="logo">M</span>Memora
    </a>
    <nav class="nav">
      <% if (locals.user) { %>
        <span style="font-weight: 600; color: var(--muted);">Hi, <%= locals.user.name %></span>
        <form action="/user/logout" method="post" style="margin:0;">
          <button type="submit">Log out</button>
        </form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/signup">Sign up</a>
          <% } %>
    </nav>
  </header>
  <main class="shell">
    <p class="eyebrow">Your thinking space</p>
    <h1>Keep the ideas you don’t want to lose.</h1>
    <p class="lead">Capture a thought in seconds, then come back to it when it matters.</p>
    <% if (locals.msg) { %>
      <p class="notice" role="status">
        <%= locals.msg %>
      </p>
      <% } %>
        <form class="composer" action="/notes" method="post">
          <div class="field"><label for="title">Title</label><input id="title" type="text" name="title"
              placeholder="A short title" required /></div>
          <div class="field"><label for="content">Your note</label><input id="content" type="text" name="content"
              placeholder="Write something worth remembering…" required /></div>
          <button type="submit">Save note</button>
        </form>
        <section aria-labelledby="notes-title">
          <div class="section-head">
            <h2 id="notes-title">Your notes</h2><span class="count">
              <%= (locals.notes && locals.notes.length) ? locals.notes.length : 0 %>
                saved
            </span>
          </div>
          <% if (locals.notes && locals.notes.length> 0) { %>
            <div class="notes">
              <% locals.notes.forEach(note=> { %>
                <article class="note">
                  <h3>
                    <%= note.title %>
                  </h3>
                  <p>
                    <%= note.content %>
                  </p>

                  <div class="note-actions">
                    <form action="/notes/<%= note._id %>/edit" method="get">
                      <button type="submit">Edit</button>
                    </form>
                    <form action="/notes/<%= note._id %>" method="post">
                      <button class="delete-button" type="submit">Delete</button>
                    </form>
                  </div>
                </article>
                <% }) %>
            </div>
            <% } else { %>
              <div class="empty"><strong>Your board is clear. </strong>Write your first
                note above to get started.</div>
              <% } %>
        </section>
  </main>
</body>

</html>