<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit note · Memora</title>
    <style>
      :root {
        --ink: #1e1b2e;
        --muted: #716d80;
        --violet: #6d4aff;
        --line: #e9e6ef;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        padding: 24px;
        color: var(--ink);
        background: #f8f7fc;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }
      .shell {
        width: min(680px, 100%);
        margin: 0 auto;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 14px 0 56px;
        color: var(--ink);
        font-size: 20px;
        font-weight: 850;
        letter-spacing: -0.05em;
        text-decoration: none;
      }
      .logo {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        color: #fff;
        border-radius: 10px;
        background: var(--violet);
      }
      .card {
        padding: clamp(24px, 6vw, 42px);
        border: 1px solid var(--line);
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 16px 44px rgba(31, 20, 75, 0.08);
      }
      .eyebrow {
        margin: 0 0 10px;
        color: var(--violet);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      h1 {
        margin: 0;
        font-size: clamp(30px, 6vw, 42px);
        letter-spacing: -0.06em;
      }
      .intro {
        margin: 12px 0 30px;
        color: var(--muted);
        line-height: 1.55;
      }
      form {
        display: grid;
        gap: 20px;
      }
      label {
        display: grid;
        gap: 8px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
      }
      input,
      textarea {
        width: 100%;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: 10px;
        outline: none;
        color: var(--ink);
        font: inherit;
        resize: vertical;
      }
      textarea {
        min-height: 160px;
        line-height: 1.5;
      }
      input:focus,
      textarea:focus {
        border-color: var(--violet);
        box-shadow: 0 0 0 3px #eeeaff;
      }
      .actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 4px;
      }
      .button {
        min-height: 43px;
        padding: 0 17px;
        border: 1px solid var(--line);
        border-radius: 10px;
        color: var(--ink);
        background: #fff;
        cursor: pointer;
        font: 750 14px inherit;
        text-decoration: none;
        display: inline-grid;
        place-items: center;
      }
      .button.primary {
        border-color: var(--violet);
        color: #fff;
        background: var(--violet);
      }
      .button:hover {
        transform: translateY(-1px);
      }
      @media (max-width: 480px) {
        body {
          padding: 16px;
        }
        .brand {
          margin: 10px 0 32px;
        }
        .actions {
          flex-direction: column-reverse;
        }
        .button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <a class="brand" href="/" aria-label="Back to Memora"
        ><span class="logo">M</span>Memora</a
      >
      <section class="card" aria-labelledby="edit-title">
        <p class="eyebrow">Note editor</p>
        <h1 id="edit-title">Refine your thought</h1>
        <p class="intro">Make your changes, then save when it feels right.</p>
        <form action="/notes/<%= note._id %>/edit" method="post">
          <label for="title"
            >Title
            <input
              id="title"
              type="text"
              name="title"
              value="<%= note.title %>"
              required
            />
          </label>
          <label for="content"
            >Your note
            <textarea id="content" name="content" required>
<%= note.content %></textarea
            >
          </label>
          <div class="actions">
            <a class="button" href="/">Cancel</a>
            <button class="button primary" type="submit">Save changes</button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
