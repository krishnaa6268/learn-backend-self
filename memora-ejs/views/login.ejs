<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in · Memora</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #1e1b2e;
        --muted: #696579;
        --violet: #6d4aff;
        --violet-dark: #5637db;
        --surface: #fff;
        --line: #e7e4ef;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: var(--ink);
        background:
          radial-gradient(circle at 10% 10%, #e9e3ff 0, transparent 32%),
          radial-gradient(circle at 90% 88%, #d7f4ef 0, transparent 28%),
          #f8f7fc;
      }
      .card {
        width: min(100%, 440px);
        padding: 40px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.88);
        box-shadow: 0 24px 70px rgba(47, 35, 103, 0.13);
        backdrop-filter: blur(12px);
      }
      .brand {
        display: flex;
        gap: 10px;
        align-items: center;
        font-weight: 800;
        letter-spacing: -0.04em;
        font-size: 20px;
      }
      .logo {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        color: #fff;
        background: var(--violet);
        box-shadow: 0 6px 14px #cfc5ff;
      }
      h1 {
        margin: 32px 0 8px;
        font-size: 30px;
        line-height: 1.1;
        letter-spacing: -0.055em;
      }
      .intro {
        margin: 0 0 28px;
        color: var(--muted);
      }
      form {
        display: grid;
        gap: 17px;
      }
      label {
        display: grid;
        gap: 7px;
        font-size: 14px;
        font-weight: 700;
      }
      input {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid var(--line);
        border-radius: 11px;
        outline: none;
        color: var(--ink);
        font: inherit;
        transition:
          border 0.2s,
          box-shadow 0.2s;
      }
      input:focus {
        border-color: var(--violet);
        box-shadow: 0 0 0 4px #eeeaff;
      }
      button {
        margin-top: 4px;
        padding: 14px;
        border: 0;
        border-radius: 11px;
        color: #fff;
        cursor: pointer;
        font: 700 15px inherit;
        background: var(--violet);
        box-shadow: 0 10px 20px #d8d0ff;
        transition:
          transform 0.15s,
          background 0.15s;
      }
      button:hover {
        background: var(--violet-dark);
        transform: translateY(-1px);
      }
      .message {
        min-height: 22px;
        margin: 17px 0 0;
        color: #b42318;
        font-size: 14px;
        font-weight: 600;
      }
      .foot {
        margin: 8px 0 0;
        text-align: center;
        color: var(--muted);
        font-size: 14px;
      }
      a {
        color: var(--violet);
        font-weight: 700;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      @media (max-width: 480px) {
        .card {
          padding: 30px 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="card">
      <div class="brand"><span class="logo">M</span>Memora</div>
      <h1>Welcome back</h1>
      <p class="intro">Log in to keep your thoughts in one place.</p>
      <form method="post" action="/user/login">
        <label
          >Email
          <input
            type="email"
            name="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </label>
        <label
          >Password
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="Your password"
            required
          />
        </label>
        <button type="submit">Log in</button>
      </form>
      <p class="message" aria-live="polite"><%= locals.msg || "" %></p>
      <p class="foot">New to Memora? <a href="/signup">Create an account</a></p>
    </main>
  </body>
</html>
