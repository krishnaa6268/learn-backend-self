<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Url Shortner | SSR</title>
  </head>
  <body>
    <p>Url Shortner</p>
    <form action="/url" method="POST">
      <input type="text" name="url" placeholder="Enter URL to shorten" required>
      <button type="submit">Generate</button>
    </form>
    <p>
      <% if (locals.id) { %>
      Shortened URL: <%= "http://localhost:8001/" + id %>
      <% } %>
    </p>

    <div>
      <% if (locals.urls) { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Short URL</th>
            <th>Original URL</th>
            <th>Clicks</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach((url, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><a href="<%= "http://localhost:8001/" + url.shortId %>"><%=
                "http://localhost:8001/" + url.shortId %></a></td>
            <td><%= url.redirectUrl %></td>
            <td><%= url.visitHistory.length %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

  </body>
</html>